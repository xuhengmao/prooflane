{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prooflane",
  "version": "0.24.0",
  "identifier": "io.github.xuhengmao.prooflane",
  "build": {
    "beforeDevCommand": "pnpm tauri:before-dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm tauri:before-build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../out": "web/"
    },
    "externalBin": ["binaries/codeg-mcp"],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFOEE3N0QxRUE2MTVFQ0MKUldUTVhtSHEwWGVLam5CN3hOeW1kTC9QMVNTb3ZRR2pPeEttS2R2YzIzelUrd3VpQUJVS1FUSmsK",
      "endpoints": [
        "https://github.com/xuhengmao/prooflane/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
